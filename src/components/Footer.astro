---
const { lang = 'it' } = Astro.props;
const year = new Date().getFullYear();
const prefix = lang === 'it' ? '' : `/${lang}`;
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-left">
      <a href={`${prefix}/`} class="footer-logo">Federica <span>Fanì</span></a>
      <p class="footer-tagline">Pianoforte e batteria. Vinili e codice.</p>
      <div class="footer-socials">
        <a href="https://instagram.com/fedefany" target="_blank" rel="noopener" aria-label="Instagram">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
        </a>
        <a href="https://linkedin.com/in/fedefany" target="_blank" rel="noopener" aria-label="LinkedIn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
        </a>
        <a href="https://github.com/fani-dev96" target="_blank" rel="noopener" aria-label="GitHub">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
        </a>
        <a href="mailto:federica.fani96@gmail.com" aria-label="Email">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        </a>
      </div>
    </div>

    <nav class="footer-nav">
      <div class="footer-nav-col">
        <div class="footer-nav-label">Pagine</div>
        <a href={`${prefix}/chi-sono`}>Chi sono</a>
        <a href={`${prefix}/servizi/smm`}>Servizi</a>
        <a href={`${prefix}/formazione`}>Formazione</a>
        <a href={`${prefix}/galleria`}>Galleria</a>
        <a href={`${prefix}/portfolio`}>Portfolio</a>
        <a href={`${prefix}/contatti`}>Contatti</a>
      </div>
    </nav>

    <div class="footer-right">
      <div class="footer-langs-label">Lingua</div>
      <div class="footer-langs">
        <a href="/" class={lang === 'it' ? 'active' : ''}>IT</a>
        <a href="/en/" class={lang === 'en' ? 'active' : ''}>EN</a>
        <a href="/es/" class={lang === 'es' ? 'active' : ''}>ES</a>
        <a href="/fr/" class={lang === 'fr' ? 'active' : ''}>FR</a>
      </div>
      <div class="footer-credits">
        Roma · {year}<br/>
        currently making noise
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <span>© {year} Federica Fanì · federicafani.com · P.IVA 02230280675</span>
    <span>Pianoforte e batteria. Vinili e codice.</span>
  </div>
</footer>

<style>
@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap');

.footer {
  background: var(--blue-dark);
  padding: 56px clamp(20px, 5vw, 80px) 24px;
  border-top: 2px solid var(--blue);
}

.footer-inner {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 48px;
  align-items: start;
  padding-bottom: 40px;
  border-bottom: 1px solid rgba(123,167,232,0.15);
}

.footer-logo {
  font-family: 'Cabinet Grotesk', sans-serif;
  font-size: 18px;
  font-weight: 400;
  color: var(--white);
  display: block;
  margin-bottom: 8px;
}

.footer-logo span { color: var(--blue); }

.footer-tagline {
  font-size: 13px;
  color: rgba(123,167,232,0.5);
  font-style: italic;
  font-family: 'Cormorant Garamond', serif;
  margin-bottom: 20px;
}

.footer-socials {
  display: flex;
  gap: 8px;
}

.footer-socials a {
  width: 36px;
  height: 36px;
  border: 1px solid rgba(123,167,232,0.2);
  border-radius: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(123,167,232,0.5);
  transition: all 0.2s ease;
}

.footer-socials a:hover {
  border-color: var(--azure);
  color: var(--white);
  background: rgba(123,167,232,0.08);
}

.footer-nav {
  display: flex;
  gap: 40px;
}

.footer-nav-col {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.footer-nav-label {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--blue);
  margin-bottom: 4px;
}

.footer-nav a {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 14px;
  font-weight: 400;
  color: rgba(123,167,232,0.7);
  transition: color 0.2s ease;
  letter-spacing: 0.02em;
}

.footer-nav a:hover { color: var(--white); }

.footer-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12px;
}

.footer-langs-label {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--blue);
}

.footer-langs {
  display: flex;
  gap: 4px;
}

.footer-langs a {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.06em;
  padding: 5px 10px;
  border-radius: 0;
  color: rgba(123,167,232,0.5);
  transition: all 0.15s ease;
}

.footer-langs a:hover { color: var(--azure); }
.footer-langs a.active { color: var(--gold); border-bottom: 1px solid var(--gold); }

.footer-credits {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 12px;
  font-weight: 400;
  color: rgba(123,167,232,0.4);
  text-align: right;
  line-height: 1.8;
  letter-spacing: 0.04em;
  margin-top: 8px;
}

.footer-bottom {
  max-width: 1200px;
  margin: 24px auto 0;
  display: flex;
  justify-content: space-between;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 12px;
  font-weight: 400;
  letter-spacing: 0.04em;
  color: rgba(123,167,232,0.3);
}

@media (max-width: 768px) {
  .footer-inner {
    grid-template-columns: 1fr;
    gap: 32px;
  }
  .footer-right { align-items: flex-start; }
  .footer-bottom { flex-direction: column; gap: 4px; }
}
</style>